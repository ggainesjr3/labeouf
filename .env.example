# Database
POSTGRES_USER=gary_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=labeouf_vault
TZ=America/New_York

# Host ports used by Docker Compose. Change these if Cursor or another stack
# already owns the default local ports.
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=3001

# Used when running the backend outside Docker.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=gary_admin
DATABASE_PASSWORD=change-me
DATABASE_NAME=labeouf_vault

# Backend
JWT_SECRET=change-me
ALLOWED_ORIGIN=http://localhost:8080
FRONTEND_URL=http://localhost:8080
WEBHOOK_URL=
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=
UPLOAD_PATH=uploads
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=false

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

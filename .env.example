# =============================================================================
# LaBeouf environment variables
# Copy to `.env` for local Docker Compose, or set in Railway/hosting dashboard.
# =============================================================================

# --- Custom domain (production) ---
# Public URL of the React app (no trailing slash)
FRONTEND_URL=https://yourdomain.com
# Comma-separated origins allowed for CORS (usually same as FRONTEND_URL + www)
ALLOWED_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
# Public URL of the NestJS API (no trailing slash)
BACKEND_URL=https://api.yourdomain.com
# Build-time: frontend calls this URL directly (Railway split services). Leave empty
# to use same-origin requests proxied by nginx (see SERVER_NAME / BACKEND_URL below).
VITE_API_URL=https://api.yourdomain.com
# nginx server_name for custom domain (use _ for any host)
SERVER_NAME=yourdomain.com

# --- Database (Postgres) ---
POSTGRES_USER=gary_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=labeouf_vault
TZ=America/New_York

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=gary_admin
DATABASE_PASSWORD=change-me
DATABASE_NAME=labeouf_vault

# --- Admin bootstrap (Railway) ---
# Protects POST /admin/promote and GET /push/test?secret=
ADMIN_PROMOTE_SECRET=change-me-long-random-string

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback

# --- TypeORM ---
# Use migrations in production; never rely on auto-sync.
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=true

# --- Email notifications (optional) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Optional integrations ---
WEBHOOK_URL=
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=
UPLOAD_PATH=uploads

# --- Cloudflare R2 (production uploads; omit for local disk storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Local Docker Compose ports ---
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=3001

# --- Capacitor / mobile dev (ngrok) ---
NGROK_BACKEND_URL=
# CAPACITOR_SERVER_URL=

# --- Legacy Firebase web config (root src/ only; use env if needed) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Railway example (replace with your service URLs or custom domain above) ---
# FRONTEND_URL=https://superb-patience-production.up.railway.app
# ALLOWED_ORIGIN=https://superb-patience-production-3fab.up.railway.app
# BACKEND_URL=https://labeouf-production.up.railway.app
# VITE_API_URL=https://labeouf-production.up.railway.app
# GOOGLE_CALLBACK_URL=https://labeouf-production.up.railway.app/auth/google/callback
